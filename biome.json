{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ":NODE:",
              [
                ":PACKAGE:",
                "!@app/**",
                "!@assets/**",
                "!@components/**",
                "!@copy",
                "!@hooks/**",
                "!@pages/**",
                "!@providers/**",
                "!@services/**",
                "!@styles/**",
                "!@test/**",
                "!@stories/**",
                "!@utils/**"
              ],
              [
                "@app/**",
                "@assets/**",
                "@components/**",
                "@copy",
                "@hooks/**",
                "@pages/**",
                "@providers/**",
                "@services/**",
                "@stories/**",
                "@styles/**",
                "@test/**",
                "@utils/**"
              ],
              ":PATH:"
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/src/assets/**/*.svg"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off"
          }
        }
      }
    }
  ]
}
