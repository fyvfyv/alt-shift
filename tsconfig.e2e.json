{
  // Playwright's page.evaluate callbacks run in the browser, so these files need the DOM lib that
  // tsconfig.server.json leaves out to keep browser globals out of server code.
  "extends": "./tsconfig.server.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "lib": ["ES2023", "DOM"]
  },
  "include": ["playwright.config.ts", "tests/e2e"]
}
