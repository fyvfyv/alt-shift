# Local server env for `pnpm dev` (copy to .env.local). Deployed environments are set in the Vercel project.

# Set it and the real API is used; leave empty for the offline mock (recorded real transcripts).
GENERATION_API_TOKEN=

# GENERATION_PROVIDER=variant|mock  (explicit override)

# Mock provider pacing.
MOCK_DELAY_MS=40
MOCK_FIRST_DELTA_MS=1200

# GENERATION_API_URL=  (defaults to the Variant endpoint)
