{
  "name": "@alt-shift/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./providers": {
      "types": "./src/providers/index.ts",
      "development": "./src/providers/index.ts",
      "default": "./dist/providers/index.js"
    },
    "./fixtures/*": "./fixtures/*",
    "./*": {
      "types": "./src/*.ts",
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "record:fixture": "node --conditions=development --env-file=../../.env.local --import tsx scripts/record-fixture.ts"
  },
  "dependencies": {
    "@alt-shift/shared": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^5.0.2",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.0.2"
  }
}
